# microCMSの管理画面URL「https://XXXX.microcms.io」の XXXX の部分を入れてください
MICROCMS_SERVICE_DOMAIN=your-service-domain

# microCMSの「サービス設定 > APIキー」で発行したキーを入れてください
MICROCMS_API_KEY=your-api-key

# Webhookからの再反映(revalidate)を呼び出す際の合言葉。好きな文字列でOK（推測されにくいものにしてください）
REVALIDATE_SECRET=please-change-this-secret

# お問い合わせフォームの送信先設定（Web3Forms: https://web3forms.com/ で無料登録して発行されるアクセスキー）
# ブラウザ側から直接送信するため NEXT_PUBLIC_ を付けています（Web3Forms公式もこの使い方を想定しています）
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key
